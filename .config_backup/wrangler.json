{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anhkhaishop",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anhkhaishop-db",
      "database_id": "your-d1-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MY_R2_BUCKET",
      "bucket_name": "anhkhaishop-images"
    }
  ]
}
